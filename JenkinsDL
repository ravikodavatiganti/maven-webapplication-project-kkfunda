pipeline
{
agent any
tools{
 maven 'maven392'
}
stages{
  stage('Git')
  {
   steps{
      git branch: 'development', url: 'https://github.com/ravikodavatiganti/maven-webapplication-project-kkfunda.git'
   } 
  } // Git stage closed 
  
  stage('Maven Build')
  {
   steps{
      sh 'mvn -B clean package'
   } 
  } // Maven Stage Close
  
  stage('SQ')
  {
   steps{
     sh 'mvn -B sonar:sonar'
   } 
  } // SQ Stage Close
  
 } // Stages close
}// Pipeline close
