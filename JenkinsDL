pipeline
{
agent any
tools{
 maven 'maven392'
}
stages{
  stage('Git')
  {
   steps{
      git branch: 'development', url: 'https://github.com/ravikodavatiganti/maven-webapplication-project-kkfunda.git'
   } 
  } // Git stage closed 
  
  stage('Maven Build')
  {
   steps{
      sh 'mvn -B clean package'
   } 
  } // Maven Stage Close
  
  stage('SQ')
  {
   steps{
     sh 'mvn -B sonar:sonar'
   } 
  } // SQ Stage Close

  stage('Nexus')
  {
   steps{
     sh 'mvn -B deploy'
   } 
  } // Nexus Stage Close

  stage('Tomcat')
  {
      steps{
          echo 'from Tomcat'
             sh """
            curl -u ravi:ravi \
            --upload-file target/maven-web-application.war \
            "http://100.52.177.243:8080/manager/text/deploy?path=/maven-web-application&update=true&war="
            """
       
       }
   
  } // Tomcat Stage Close
  
 } // Stages close
}// Pipeline close
